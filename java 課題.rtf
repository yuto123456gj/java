public class TotalCalculator \{\
    public static void main(String[] args) \{\
        Scanner scanner = new Scanner(System.in);\
        int[] numbers = new int[100];\
        int count = 0;\
\
        System.out.println("\uc0\u21152 \u31639 \u12377 \u12427 \u25968 \u20516 \u12434 \u20837 \u21147 \u12375 \u12390 \u12367 \u12384 \u12373 \u12356 ");\
\
        while (count < 100) \{\
            String input = scanner.nextLine();\
\
            // exit\uc0\u12364 \u20837 \u21147 \u12373 \u12428 \u12383 \u12425 \u12523 \u12540 \u12503 \u12434 \u25244 \u12369 \u12427 \
            if (input.equalsIgnoreCase("exit")) \{\
                break;\
            \}\
\
            try \{\
                // \uc0\u20837 \u21147 \u12373 \u12428 \u12383 \u25991 \u23383 \u21015 \u12434 \u25968 \u20516 \u12395 \u22793 \u25563 \u12375 \u12390 \u37197 \u21015 \u12395 \u26684 \u32013 \
                numbers[count] = Integer.parseInt(input);\
                count++;\
            \} catch (NumberFormatException e) \{\
                System.out.println("\uc0\u28961 \u21177 \u12394 \u20837 \u21147 \u12391 \u12377 \u12290 \u25968 \u20516 \u12414 \u12383 \u12399  'exit' \u12434 \u20837 \u21147 \u12375 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 ");\
            \}\
        \}\
\
        // \uc0\u37197 \u21015 \u12398 \u20013 \u36523 \u12434 \u21512 \u35336 \
        int sum = 0;\
        for (int i = 0; i < count; i++) \{\
            sum += numbers[i];\
        \}\
\
        System.out.println("\uc0\u21512 \u35336 \u12399 " + sum + "\u12391 \u12377 ");\
        scanner.close();\
    \}\
\}\
